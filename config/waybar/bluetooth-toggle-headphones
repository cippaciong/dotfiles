#!/usr/bin/env bash
set -u

DEVICE_MAC="2C:E0:32:B5:15:EA"
DEVICE_ALIAS="JBL TUNE660NC"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Bluetooth" "$1"
  fi
}

connected="$(
  bluetoothctl info "$DEVICE_MAC" 2>/dev/null |
    awk -F': ' '/^[[:space:]]*Connected:/ { print $2; exit }'
)"

if [[ "$connected" == "yes" ]]; then
  if bluetoothctl disconnect "$DEVICE_MAC" >/dev/null 2>&1; then
    notify "Disconnected $DEVICE_ALIAS"
    exit 0
  fi

  notify "Could not disconnect $DEVICE_ALIAS"
  exit 1
fi

bluetoothctl power on >/dev/null 2>&1
bluetoothctl trust "$DEVICE_MAC" >/dev/null 2>&1

if bluetoothctl connect "$DEVICE_MAC" >/dev/null 2>&1; then
  notify "Connected $DEVICE_ALIAS"
  exit 0
fi

notify "Could not connect $DEVICE_ALIAS"
exit 1
